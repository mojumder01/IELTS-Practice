# Copy to .env.local and fill in. Never commit the filled-in file.
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration.
# The web config is not secret, but it stays out of the repo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# The one Google account allowed in: Firebase console → Authentication → Users → User UID.
VITE_OWNER_UID=

# Optional. reCAPTCHA v3 site key for Firebase App Check, which keeps the free
# Gemini quota for this app (docs/SETUP.md, step 10).
VITE_RECAPTCHA_SITE_KEY=

# Optional. The Gemini model for Writing feedback; defaults to the one in src/lib/aiFirebase.ts.
VITE_WRITING_MODEL=
